# Copie ce fichier en ".env" puis remplis les valeurs.

# Port du serveur
PORT=3000
# Adresse publique de ton site (utilisée pour les webhooks de paiement)
PUBLIC_URL=https://vupay.example.com
# Fuseau horaire utilisé pour "aujourd'hui" (objectif et bonus du jour)
TIMEZONE=Africa/Dakar

# Jeton pour ouvrir /admin.html : mets une longue phrase secrète
ADMIN_TOKEN=change-moi-par-un-long-secret

# 1 = le code SMS s'affiche dans l'appli (pour tester). TOUJOURS 0 en production.
DEV_SHOW_OTP=1

# Règles de gain
MIN_WITHDRAW=2000
DAILY_GOAL=5
DAILY_BONUS=300

# 1 = ajoute les 8 vidéos de démonstration dessinées au premier démarrage. 0 = aucune.
SEED_DEMO=1

# Vidéos des annonceurs
MAX_UPLOAD_MB=300
MAX_VIDEO_SECONDS=180

# ---- SMS : console (affiché dans le terminal) ou http (ton fournisseur, voir providers.js)
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=VuPay

# ---- Retraits : simulation (aucun argent envoyé), manual (tu paies et valides dans /admin.html)
#      ou http (ton agrégateur Mobile Money, voir providers.js)
PAYOUT_PROVIDER=simulation
PAYOUT_API_URL=
PAYOUT_API_KEY=
PAYOUT_WEBHOOK_SECRET=
